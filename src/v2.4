bool isProtocolSupported(int8_t proto) {
  switch (proto) {
    case NEC: case SONY: case RC5: case RC6: case PANASONIC: case JVC:
    case SAMSUNG: case LG: case SHARP: case RC5X: case DENON:
    case AIWA_RC_T501: case PIONEER: return true;
    default: return false;
  }
}

bool isACProtocol(int8_t proto) {
  switch (proto) {
    case COOLIX: case VOLTAS: case DAIKIN: case MITSUBISHI: case TOSHIBA_AC:
    case FUJITSU_AC: case HAIER_AC: case HITACHI_AC: case GREE: case MIDEA:
    case TCL112AC: case CARRIER_AC: case WHIRLPOOL_AC: return true;
    default: return false;
  }
}

// Fix J: Refactored loadProfiles/saveProfiles to use inner slot loop.
// NVS key names are unchanged — backward compatible with v2 saved data.
// Fix E: Key buffers enlarged from char[20] to char[24] to prevent overflow
//        (longest key = name[9] + "_ac4_value"[10] + NUL = 20, so 24 is safe).

// Helper: fill key buffer for a given profile name, field suffix, and slot (1-4).
static void makeKey(char* buf, size_t bufLen, const char* name, const char* field, int slot) {
  snprintf(buf, bufLen, "%s_%s%d", name, field, slot);
}

void loadProfiles() {
  for (int i = 0; i < numRemotes; i++) {
    char key[24];
    for (int slot = 1; slot <= 4; slot++) {
      // --- command / protocol ---
      makeKey(key, sizeof(key), remotes[i].name, "cmd", slot);
      uint64_t cmd = prefs.getULong64(key, 0);
      makeKey(key, sizeof(key), remotes[i].name, "proto", slot);
      int8_t proto = prefs.getChar(key, -1);

      // --- raw IR ---
      makeKey(key, sizeof(key), remotes[i].name, "raw", slot);
      // Fix F: Copy into non-volatile local buffer first before writing to struct,
      // avoiding undefined behaviour from discarding volatile on rawbuf.
      uint16_t rawTmp[MAX_RAW_LEN];
      size_t rawBytes = prefs.getBytes(key, rawTmp, MAX_RAW_LEN * sizeof(uint16_t));
      uint16_t rawLen = (rawBytes > 0 && rawBytes % sizeof(uint16_t) == 0) ? rawBytes / sizeof(uint16_t) : 0;

      // --- AC state ---
      makeKey(key, sizeof(key), remotes[i].name, "ac", slot);
      uint8_t acData[MAX_AC_STATE_LEN];
      size_t acLen = prefs.getBytes(key, acData, MAX_AC_STATE_LEN);

      makeKey(key, sizeof(key), remotes[i].name, "ac", slot); // reuse suffix via proto
      char acProtoKey[24]; snprintf(acProtoKey, sizeof(acProtoKey), "%s_ac%d_proto", remotes[i].name, slot);
      char acDescKey[24];  snprintf(acDescKey, sizeof(acDescKey), "%s_ac%d_desc", remotes[i].name, slot);
      char acValKey[24];   snprintf(acValKey, sizeof(acValKey), "%s_ac%d_value", remotes[i].name, slot);

      decode_type_t acProto = (decode_type_t)prefs.getChar(acProtoKey, UNKNOWN);
      uint64_t acValue = prefs.getULong64(acValKey, 0);
      String acDesc = prefs.getString(acDescKey, "");

      // Write into the correct slot
      switch (slot) {
        case 1:
          remotes[i].command1 = cmd; remotes[i].proto1 = proto;
          memcpy(remotes[i].raw1.data, rawTmp, rawLen * sizeof(uint16_t)); remotes[i].raw1.length = rawLen;
          memcpy(remotes[i].ac1.data, acData, acLen); remotes[i].ac1.length = acLen;
          remotes[i].ac1.protocol = acProto; remotes[i].ac1.value = acValue;
          acDesc.toCharArray(remotes[i].ac1.description, sizeof(remotes[i].ac1.description));
          break;
        case 2:
          remotes[i].command2 = cmd; remotes[i].proto2 = proto;
          memcpy(remotes[i].raw2.data, rawTmp, rawLen * sizeof(uint16_t)); remotes[i].raw2.length = rawLen;
          memcpy(remotes[i].ac2.data, acData, acLen); remotes[i].ac2.length = acLen;
          remotes[i].ac2.protocol = acProto; remotes[i].ac2.value = acValue;
          acDesc.toCharArray(remotes[i].ac2.description, sizeof(remotes[i].ac2.description));
          break;
        case 3:
          remotes[i].command3 = cmd; remotes[i].proto3 = proto;
          memcpy(remotes[i].raw3.data, rawTmp, rawLen * sizeof(uint16_t)); remotes[i].raw3.length = rawLen;
          memcpy(remotes[i].ac3.data, acData, acLen); remotes[i].ac3.length = acLen;
          remotes[i].ac3.protocol = acProto; remotes[i].ac3.value = acValue;
          acDesc.toCharArray(remotes[i].ac3.description, sizeof(remotes[i].ac3.description));
          break;
        case 4:
          remotes[i].command4 = cmd; remotes[i].proto4 = proto;
          memcpy(remotes[i].raw4.data, rawTmp, rawLen * sizeof(uint16_t)); remotes[i].raw4.length = rawLen;
          memcpy(remotes[i].ac4.data, acData, acLen); remotes[i].ac4.length = acLen;
          remotes[i].ac4.protocol = acProto; remotes[i].ac4.value = acValue;
          acDesc.toCharArray(remotes[i].ac4.description, sizeof(remotes[i].ac4.description));
          break;
      }
    }
#ifdef DEBUG
    Serial.printf("Loaded profile %s\n", remotes[i].name);
    debugProfile(i);
#endif
  }
}

void saveProfiles() {
  bool saveSuccess = true;
  for (int i = 0; i < numRemotes; i++) {
    char key[24];
    for (int slot = 1; slot <= 4; slot++) {
      uint64_t cmd = 0; int8_t proto = -1;
      IRCode* raw = nullptr; ACCode* acPtr = nullptr;
      switch (slot) {
        case 1: cmd = remotes[i].command1; proto = remotes[i].proto1; raw = &remotes[i].raw1; acPtr = &remotes[i].ac1; break;
        case 2: cmd = remotes[i].command2; proto = remotes[i].proto2; raw = &remotes[i].raw2; acPtr = &remotes[i].ac2; break;
        case 3: cmd = remotes[i].command3; proto = remotes[i].proto3; raw = &remotes[i].raw3; acPtr = &remotes[i].ac3; break;
        case 4: cmd = remotes[i].command4; proto = remotes[i].proto4; raw = &remotes[i].raw4; acPtr = &remotes[i].ac4; break;
      }
      makeKey(key, sizeof(key), remotes[i].name, "cmd", slot);
      saveSuccess &= prefs.putULong64(key, cmd);
      makeKey(key, sizeof(key), remotes[i].name, "proto", slot);
      saveSuccess &= prefs.putChar(key, proto);
      makeKey(key, sizeof(key), remotes[i].name, "raw", slot);
      if (raw && raw->length > 0) saveSuccess &= prefs.putBytes(key, raw->data, raw->length * sizeof(uint16_t));

      char acKey[24];   snprintf(acKey, sizeof(acKey), "%s_ac%d", remotes[i].name, slot);
      char acProtoKey[24]; snprintf(acProtoKey, sizeof(acProtoKey), "%s_ac%d_proto", remotes[i].name, slot);
      char acDescKey[24];  snprintf(acDescKey, sizeof(acDescKey), "%s_ac%d_desc", remotes[i].name, slot);
      char acValKey[24];   snprintf(acValKey, sizeof(acValKey), "%s_ac%d_value", remotes[i].name, slot);

      if (acPtr && acPtr->length > 0) saveSuccess &= prefs.putBytes(acKey, acPtr->data, acPtr->length);
      if (acPtr) {
        saveSuccess &= prefs.putChar(acProtoKey, (char)acPtr->protocol);
        saveSuccess &= prefs.putString(acDescKey, acPtr->description);
        saveSuccess &= prefs.putULong64(acValKey, acPtr->value);
      }
    }
#ifdef DEBUG
    if (!saveSuccess) Serial.println("Save failed for " + String(remotes[i].name));
    else Serial.println("Profiles saved for " + String(remotes[i].name));
    debugProfile(i);
#endif
  }
  saveSuccess &= prefs.putInt("currentIndex", currentIndex);
  if (!saveSuccess) showFeedback("Save Failed!");
}

// Shared AC send helper — eliminates duplicated switch blocks throughout the file.
bool sendACByCode(ACCode* ac, IRCode* raw) {
  if (ac && ac->protocol != UNKNOWN && (ac->length > 0 || ac->value != 0)) {
    switch (ac->protocol) {
      case VOLTAS:      { IRVoltas a(IR_SEND_PIN);       a.begin(); a.setRaw(ac->data);             a.send(); return true; }
      case COOLIX:      { IRCoolixAC a(IR_SEND_PIN);     a.begin(); a.setRaw((uint32_t)ac->value);  a.send(); return true; }
      case DAIKIN:      { IRDaikinESP a(IR_SEND_PIN);    a.begin(); a.setRaw(ac->data);             a.send(); return true; }
      case MITSUBISHI:  { IRMitsubishiAC a(IR_SEND_PIN); a.begin(); a.setRaw(ac->data);             a.send(); return true; }
      case TOSHIBA_AC:  { IRToshibaAC a(IR_SEND_PIN);   a.begin(); a.setRaw(ac->data);             a.send(); return true; }
      case FUJITSU_AC:  { IRFujitsuAC a(IR_SEND_PIN);   a.begin(); a.setRaw(ac->data, ac->length); a.send(); return true; }
      case HAIER_AC:    { IRHaierAC a(IR_SEND_PIN);     a.begin(); a.setRaw(ac->data);             a.send(); return true; }
      case HITACHI_AC:  { IRHitachiAc a(IR_SEND_PIN);   a.begin(); a.setRaw(ac->data);             a.send(); return true; }
      case GREE:        { IRGreeAC a(IR_SEND_PIN);       a.begin(); a.setRaw(ac->data);             a.send(); return true; }
      case MIDEA:       { IRMideaAC a(IR_SEND_PIN);      a.begin(); a.setRaw(ac->value);            a.send(); return true; }
      case TCL112AC:    { IRTcl112Ac a(IR_SEND_PIN);    a.begin(); a.setRaw(ac->data);             a.send(); return true; }
      case CARRIER_AC:  { IRCarrierAc64 a(IR_SEND_PIN); a.begin(); a.setRaw(ac->value);            a.send(); return true; }
      case WHIRLPOOL_AC:{ IRWhirlpoolAc a(IR_SEND_PIN); a.begin(); a.setRaw(ac->data);             a.send(); return true; }
      default: break;
    }
  }
  if (raw && raw->length > 0) {
    irsend.sendRaw(raw->data, raw->length, AC_RAW_FREQ);
    return true;
  }
  return false;
}

// Fix B: Shared non-AC IR send helper — replaces two identical switch blocks
// that previously existed in sendCmd() and the loop() capture-test section.
bool sendIRByProtoAndCode(int8_t proto, uint64_t code, IRCode* rawCode, const char* profileName) {
  if (isProtocolSupported(proto) && code != 0) {
    switch (proto) {
      case NEC:          irsend.sendNEC(code, 32);        break;
      case SONY:         irsend.sendSony(code, 12);       break;
      case RC5:          irsend.sendRC5(code, 12);        break;
      case RC6:          irsend.sendRC6(code, 20);        break;
      case PANASONIC:    irsend.sendPanasonic64(code);    break;
      case JVC:          irsend.sendJVC(code, 16);        break;
      case SAMSUNG:      irsend.sendSAMSUNG(code, 32);    break;
      case LG:           irsend.sendLG(code, 28);         break;
      case SHARP:        irsend.sendSharpRaw(code, 15);   break;
      case RC5X:         irsend.sendRC5(code, 12);        break;
      case DENON:        irsend.sendDenon(code, 14);      break;
      case AIWA_RC_T501: irsend.sendAiwaRCT501(code);     break;
      case PIONEER:      irsend.sendPioneer(code, 64);    break;
    }
#ifdef DEBUG
    Serial.println("SENT " + getProtocolName(proto));
#endif
    return true;
  }
  if (rawCode && rawCode->length > 0) {
    int freq = (profileName && strcmp(profileName, "TV") == 0) ? TV_RAW_FREQ : SPK_RAW_FREQ;
    irsend.sendRaw(rawCode->data, rawCode->length, freq);
#ifdef DEBUG
    Serial.println("SENT RAW");
#endif
    return true;
  }
  return false;
}

void sendACCmd(int profile, int btn) {
  ACCode* acCode = nullptr;
  IRCode* rawCode = nullptr;
  switch (btn) {
    case 1: acCode = &remotes[profile].ac1; rawCode = &remotes[profile].raw1; break;
    case 2: acCode = &remotes[profile].ac2; rawCode = &remotes[profile].raw2; break;
    case 3: acCode = &remotes[profile].ac3; rawCode = &remotes[profile].raw3; break;
    case 4: acCode = &remotes[profile].ac4; rawCode = &remotes[profile].raw4; break;
    default:
#ifdef DEBUG
      Serial.println("Invalid button");
#endif
      return;
  }
#ifdef DEBUG
  Serial.printf("Sending AC cmd for BTN%d: proto=%s, value=0x%llX, len=%d, raw_len=%d\n",
                btn, typeToString(acCode->protocol).c_str(), acCode->value, acCode->length, rawCode->length);
#endif
  irrecv.disableIRIn();
  digitalWrite(DEBUG_LED, HIGH);
  bool commandSent = sendACByCode(acCode, rawCode);
  digitalWrite(DEBUG_LED, LOW);
  irrecv.enableIRIn();
#ifdef DEBUG
  Serial.println("IR receiver re-enabled after sendACCmd");
#endif
  if (!commandSent) {
#ifdef DEBUG
    Serial.println("No AC cmd for BTN" + String(btn));
#endif
    showFeedback("No Cmd Saved!");
  }
}

void sendCmd(int profile, int btn) {
#ifdef DEBUG
  Serial.println("Send " + String(remotes[profile].name) + ": BTN" + String(btn));
#endif
  if (strcmp(remotes[profile].name, "AC") == 0 || strcmp(remotes[profile].name, "AC_X") == 0) {
    sendACCmd(profile, btn);
  } else {
    IRCode* codeRaw = nullptr; uint64_t code = 0; int8_t proto = -1;
    switch (btn) {
      case 1: code = remotes[profile].command1; proto = remotes[profile].proto1; codeRaw = &remotes[profile].raw1; break;
      case 2: code = remotes[profile].command2; proto = remotes[profile].proto2; codeRaw = &remotes[profile].raw2; break;
      case 3: code = remotes[profile].command3; proto = remotes[profile].proto3; codeRaw = &remotes[profile].raw3; break;
      case 4: code = remotes[profile].command4; proto = remotes[profile].proto4; codeRaw = &remotes[profile].raw4; break;
      default:
#ifdef DEBUG
        Serial.println("Invalid button");
#endif
        return;
    }
    irrecv.disableIRIn();
    digitalWrite(DEBUG_LED, HIGH);
    bool commandSent = sendIRByProtoAndCode(proto, code, codeRaw, remotes[profile].name); // Fix B
    digitalWrite(DEBUG_LED, LOW);
    irrecv.enableIRIn();
    if (!commandSent) showFeedback("No Cmd Saved!");
  }
}

void sendBTCmd(int btn) {
  static unsigned long lastBTCmdTime = 0;
  if (millis() - lastBTCmdTime < 200) return;
  if (bleKeyboard.isConnected()) {
    switch (btn) {
      case 1: bleKeyboard.write(KEY_MEDIA_PLAY_PAUSE); showFeedback("Play/Pause");  break;
      case 2: bleKeyboard.write(KEY_MEDIA_VOLUME_UP);  showFeedback("Volume Up");   break;
      case 3: bleKeyboard.write(KEY_MEDIA_MUTE);        showFeedback("Mute");        break;
      case 4: bleKeyboard.write(KEY_MEDIA_VOLUME_DOWN); showFeedback("Volume Down"); break;
      default: showFeedback("Invalid BT Cmd"); return;
    }
    lastBTCmdTime = millis();
  } else {
    showFeedback("BT Not Connected!");
  }
}

void switchDevice() {
  connectedDeviceIndex = (connectedDeviceIndex + 1) % 3;
  if (!bleKeyboard.isConnected()) restartAdvertising();
  showFeedback(("Pair: " + deviceNames[connectedDeviceIndex]).c_str());
}

bool validateRawTimings(const decode_results& results) {
  for (int i = 1; i < results.rawlen; i++) {
    if (results.rawbuf[i] < 10 || results.rawbuf[i] > 20000) return false;
  }
  return true;
}

void handleButtonPress(int btn) {
  lastActivity = millis();
  if (btn == 5) {
    if (strcmp(remotes[currentIndex].name, "BT") == 0) {
      static unsigned long lastRecPressTime = 0;
      if (millis() - lastRecPressTime >= 200) { switchDevice(); lastRecPressTime = millis(); }
    } else {
      recordMode = !recordMode; hasReceived = false; recVisible = false;
      lastBlink = millis(); needsDisplayUpdate = true;
    }
    return;
  }
  if (strcmp(remotes[currentIndex].name, "BT") == 0 && !recordMode && !isMenu) {
    sendBTCmd(btn); return;
  }
  if (hasReceived) {
    if (strcmp(remotes[currentIndex].name, "AC") == 0 || strcmp(remotes[currentIndex].name, "AC_X") == 0) {
      ACCode* acTarget = nullptr; IRCode* rawTarget = nullptr;
      switch (btn) {
        case 1: acTarget = &remotes[currentIndex].ac1; rawTarget = &remotes[currentIndex].raw1; break;
        case 2: acTarget = &remotes[currentIndex].ac2; rawTarget = &remotes[currentIndex].raw2; break;
        case 3: acTarget = &remotes[currentIndex].ac3; rawTarget = &remotes[currentIndex].raw3; break;
        case 4: acTarget = &remotes[currentIndex].ac4; rawTarget = &remotes[currentIndex].raw4; break;
        default: showFeedback("Save Failed!"); return; // Fix C
      }
      if (lastCapturedAC.length > 0 || lastCapturedAC.value != 0) {
        memcpy(acTarget->data, lastCapturedAC.data, lastCapturedAC.length);
        acTarget->length = lastCapturedAC.length;
        acTarget->protocol = lastCapturedAC.protocol;
        strncpy(acTarget->description, lastCapturedAC.description, sizeof(acTarget->description) - 1);
        acTarget->description[sizeof(acTarget->description) - 1] = '\0';
        acTarget->value = lastCapturedAC.value;
      }
      if (lastReceived.rawlen > 0 && lastReceived.rawlen <= MAX_RAW_LEN && validateRawTimings(lastReceived)) {
        // Fix F: volatile-safe copy via local tmp
        uint16_t rawTmp[MAX_RAW_LEN];
        for (int i = 0; i < lastReceived.rawlen; i++) rawTmp[i] = lastReceived.rawbuf[i];
        memcpy(rawTarget->data, rawTmp, lastReceived.rawlen * sizeof(uint16_t));
        rawTarget->length = lastReceived.rawlen;
      }
      if (acTarget->length > 0 || acTarget->value != 0 || rawTarget->length > 0) {
        saveProfiles(); recordMode = false; hasReceived = false; recVisible = false;
        showFeedback(("Cmd" + String(btn) + " Saved").c_str());
      } else {
        showFeedback("Save Failed!");
      }
    } else {
      IRCode* rawTarget = nullptr; uint64_t* command = nullptr; int8_t* proto = nullptr;
      switch (btn) {
        case 1: rawTarget = &remotes[currentIndex].raw1; command = &remotes[currentIndex].command1; proto = &remotes[currentIndex].proto1; break;
        case 2: rawTarget = &remotes[currentIndex].raw2; command = &remotes[currentIndex].command2; proto = &remotes[currentIndex].proto2; break;
        case 3: rawTarget = &remotes[currentIndex].raw3; command = &remotes[currentIndex].command3; proto = &remotes[currentIndex].proto3; break;
        case 4: rawTarget = &remotes[currentIndex].raw4; command = &remotes[currentIndex].command4; proto = &remotes[currentIndex].proto4; break;
        default: showFeedback("Save Failed!"); return;
      }
      bool saved = false;
      if (lastCapturedProto != -1 && isProtocolSupported(lastCapturedProto) && lastCapturedCode != 0) {
        *command = lastCapturedCode; *proto = lastCapturedProto; saved = true;
      }
      if (lastReceived.rawlen > 0 && lastReceived.rawlen <= MAX_RAW_LEN && validateRawTimings(lastReceived)) {
        // Fix F: volatile-safe copy
        uint16_t rawTmp[MAX_RAW_LEN];
        for (int i = 0; i < lastReceived.rawlen; i++) rawTmp[i] = lastReceived.rawbuf[i];
        memcpy(rawTarget->data, rawTmp, lastReceived.rawlen * sizeof(uint16_t));
        rawTarget->length = lastReceived.rawlen; saved = true;
      }
      if (saved) {
        saveProfiles(); recordMode = false; hasReceived = false; recVisible = false;
        showFeedback(("Cmd" + String(btn) + " Saved").c_str());
      } else {
        showFeedback("Save Failed!");
      }
    }
  } else if (!recordMode && !isMenu) {
    sendCmd(currentIndex, btn);
  }
}

void showMenu() {
  display.ssd1306_command(SSD1306_DISPLAYON); isDisplayOn = true;
  display.clearDisplay();
  display.setTextSize(2); display.setCursor(0, 0); display.println("Select:");
  display.setTextSize(4);
  String text = String(remotes[highlighted].name);
  int x = max(0, (SCREEN_WIDTH - (int)(text.length() * 24)) / 2);
  display.setCursor(x, 20); display.println(text);
  if (recordMode && recVisible) {
    display.setTextSize(1); display.setCursor(SCREEN_WIDTH - 30, 8); display.println("REC");
  }
  display.setTextSize(1); display.setCursor(SCREEN_WIDTH - 30, 0);
  display.printf("%d%%", batteryPercentage);
  if (strcmp(remotes[currentIndex].name, "BT") == 0) {
    display.setCursor(0, 56);
    display.println(bleKeyboard.isConnected() ? "BT Connected" : "BT Disconnected");
  }
  display.display();
  lastDisplayUpdate = millis(); lastActivity = millis(); needsDisplayUpdate = false;
}

void showSelected() {
  display.ssd1306_command(SSD1306_DISPLAYON); isDisplayOn = true;
  display.clearDisplay();
  display.setTextSize(2); display.setCursor(0, 0); display.println("Selected:");
  String text = String("* ") + remotes[currentIndex].name + " *";
  int x = max(0, (SCREEN_WIDTH - (int)(text.length() * 12)) / 2);
  display.setCursor(x, 20); display.println(text);
  if (recordMode) {
    display.setTextSize(1); display.setCursor(0, 56);
    if (hasReceived) {
      display.println("Signal captured!");
      display.println("Press BTN1/2/3/4 to save");
    } else {
      display.println("Point remote & press key");
    }
    if (recVisible) { display.setCursor(SCREEN_WIDTH - 30, 8); display.println("REC"); }
  } else {
    // Fix D: Only show BT status line when BT profile is active — avoids
    // "BT Disconnected" appearing on TV/AC/SPK selected screens.
    if (strcmp(remotes[currentIndex].name, "BT") == 0) {
      display.setTextSize(1); display.setCursor(0, 56);
      display.println(bleKeyboard.isConnected() ? "BT Connected" : "BT Disconnected");
    }
  }
  display.setTextSize(1); display.setCursor(SCREEN_WIDTH - 30, 0);
  display.printf("%d%%", batteryPercentage);
  display.display();
  lastDisplayUpdate = millis(); lastActivity = millis(); needsDisplayUpdate = false;
}

void showFeedback(const char* msg) {
  display.ssd1306_command(SSD1306_DISPLAYON); isDisplayOn = true;
  display.clearDisplay();
  display.setTextSize(2); display.setCursor(0, 0); display.println("Feedback:");
  String text = String(remotes[currentIndex].name);
  int x = max(0, (SCREEN_WIDTH - (int)(text.length() * 12)) / 2);
  display.setCursor(x, 20); display.println(text);
  display.setTextSize(2); display.setCursor(0, 48); display.println(msg);
  display.setTextSize(1); display.setCursor(SCREEN_WIDTH - 30, 0);
  display.printf("%d%%", batteryPercentage);
  display.display();
  feedbackStart = millis(); showingFeedback = true;
}

void enterDeepSleep() {
#ifdef DEBUG
  Serial.println("Entering deep sleep...");
#endif
  // Fix H: Delete task from WDT first, mark flag, then deinit subsystem.
  // This prevents undefined behaviour if deinit is called after a WDT fire.
  if (wdtInitialized) {
    esp_task_wdt_delete(NULL);
    wdtInitialized = false;
    esp_task_wdt_deinit();
  }
  display.clearDisplay();
  display.ssd1306_command(SSD1306_DISPLAYOFF);
  isDisplayOn = false;
  display.display();
  irrecv.disableIRIn();
  digitalWrite(DEBUG_LED, LOW);
  savedCurrentIndex = currentIndex;
  esp_deep_sleep_start();
}

#ifdef DEBUG
void debugIRCapture(const decode_results& results) {
  Serial.println("=== IR Capture Debug ===");
  Serial.println("Profile: " + String(remotes[currentIndex].name));
  Serial.println("Decode type: " + String(typeToString(results.decode_type)));
  Serial.println("Bits: " + String(results.bits));
  Serial.println("Value: 0x" + String(results.value, HEX));
  Serial.println("Raw length: " + String(results.rawlen));
  Serial.println("Overflow: " + String(results.overflow ? "Yes" : "No"));
  if (results.rawlen > 0) {
    Serial.print("Raw timings: ");
    for (int i = 1; i < results.rawlen; i++) { Serial.print(results.rawbuf[i]); Serial.print(" "); }
    Serial.println();
  }
  if (results.state != NULL && results.bits > 0) {
    Serial.print("State data: ");
    for (int i = 0; i < (results.bits + 7) / 8; i++) { Serial.printf("0x%02X ", results.state[i]); }
    Serial.println();
  }
  Serial.println("Is AC: " + String(isACProtocol(results.decode_type) ? "Yes" : "No"));
  Serial.println("=====================");
}
#endif

void processButtons() {
  for (int i = 0; i < 5; i++) {
    if (buttonPressed[i]) {
      noInterrupts(); buttonPressed[i] = false; interrupts();
#ifdef DEBUG
      Serial.println("BTN" + String(i + 1) + (i == 4 ? " (REC)" : "") + " pressed");
#endif
      handleButtonPress(i + 1);
      lastActivity = millis();
    }
  }
}

void loop() {
  if (wdtInitialized) esp_task_wdt_reset();
  if (millis() - lastBatteryUpdate >= BATT_UPDATE_INTERVAL) {
    updateBatteryPercentage(); needsDisplayUpdate = true;
  }
  if (millis() - lastActivity >= SLEEP_TIMEOUT) enterDeepSleep();
  if (showingFeedback && millis() - feedbackStart >= 500) {
    showingFeedback = false; needsDisplayUpdate = true;
  }
  if (recordMode && millis() - lastBlink >= 500 && millis() - lastDisplayUpdate >= 500) {
    recVisible = !recVisible; lastBlink = millis(); needsDisplayUpdate = true;
  }
  static bool lastRecordMode = false;
  static bool lastHasReceived = false;
  static int lastHighlighted = -1;
  static int lastCurrentIndex = -1;
  if ((lastRecordMode != recordMode || lastHasReceived != hasReceived ||
       lastHighlighted != highlighted || lastCurrentIndex != currentIndex ||
       needsDisplayUpdate) && millis() - lastDisplayUpdate >= 80) {
    if (isMenu) showMenu(); else showSelected();
    lastRecordMode = recordMode; lastHasReceived = hasReceived;
    lastHighlighted = highlighted; lastCurrentIndex = currentIndex;
  }
  {
    long c = encoder.getCount();
    if (c != lastEncoderCount) {
      long delta = c - lastEncoderCount; lastEncoderCount = c;
      if (isMenu) highlighted = ((highlighted + (int)delta) % numRemotes + numRemotes) % numRemotes;
      lastActivity = millis(); needsDisplayUpdate = true;
    }
  }
  if (encoderBtnPressed) {
    noInterrupts(); encoderBtnPressed = false; interrupts();
    isMenu = !isMenu;
    if (isMenu) { highlighted = currentIndex; showMenu(); }
    else { currentIndex = highlighted; prefs.putInt("currentIndex", currentIndex); showSelected(); }
    lastActivity = millis(); needsDisplayUpdate = true;
  }
  processButtons();
  if (!bleKeyboard.isConnected() && isBLEInitialized && millis() - lastAdvertisingStart >= advertisingTimeout) {
    restartAdvertising();
  }
  if (recordMode && irrecv.decode(&lastReceived)) {
    digitalWrite(DEBUG_LED, HIGH);
#ifdef DEBUG
    debugIRCapture(lastReceived);
#endif
    bool validSignal = false;
    bool isACProfile = (strcmp(remotes[currentIndex].name, "AC") == 0 || strcmp(remotes[currentIndex].name, "AC_X") == 0);
    uint16_t maxRawLen = isACProfile ? kCaptureBufferSize : kMaxRawLenNonAC;
    if (lastReceived.overflow) {
      showFeedback("Buffer Overflow!");
    } else if (lastReceived.rawlen > 0 || lastReceived.decode_type != UNKNOWN) {
      if (lastReceived.rawlen > maxRawLen) showFeedback("Raw Too Long!");
      else validSignal = true;
    }
    if (validSignal && isACProfile) {
      lastCapturedAC.protocol = lastReceived.decode_type;
      snprintf(lastCapturedAC.description, sizeof(lastCapturedAC.description), "%s Cmd",
               typeToString(lastReceived.decode_type).c_str());
      if (isACProtocol(lastReceived.decode_type) && lastReceived.state && lastReceived.bits > 0) {
        size_t stateLen = (lastReceived.bits + 7) / 8;
        if (stateLen > MAX_AC_STATE_LEN) {
          showFeedback("State Too Large!");
        } else {
          memcpy(lastCapturedAC.data, lastReceived.state, stateLen);
          lastCapturedAC.length = stateLen; lastCapturedAC.value = lastReceived.value;
          hasReceived = true;
        }
      } else if (lastReceived.bits <= 64) {
        lastCapturedAC.value = lastReceived.value;
        size_t stateLen = (lastReceived.bits + 7) / 8;
        if (stateLen > MAX_AC_STATE_LEN) {
          showFeedback("State Too Large!");
        } else {
          for (int i = 0; i < (int)stateLen; i++)
            lastCapturedAC.data[i] = (uint8_t)((lastReceived.value >> (i * 8)) & 0xFF);
          lastCapturedAC.length = stateLen; hasReceived = true;
        }
      }
      if (lastReceived.rawlen > 0 && lastReceived.rawlen <= MAX_RAW_LEN && validateRawTimings(lastReceived))
        hasReceived = true;
      if (hasReceived) {
        irrecv.disableIRIn();
        if (isACProtocol(lastCapturedAC.protocol) && (lastCapturedAC.length > 0 || lastCapturedAC.value != 0)) {
          digitalWrite(DEBUG_LED, HIGH);
          sendACByCode(&lastCapturedAC, nullptr);
          digitalWrite(DEBUG_LED, LOW);
        } else if (lastReceived.rawlen > 0) {
          // Fix F: volatile-safe copy for raw test send
          uint16_t rawTmp[MAX_RAW_LEN];
          for (int i = 0; i < lastReceived.rawlen; i++) rawTmp[i] = lastReceived.rawbuf[i];
          digitalWrite(DEBUG_LED, HIGH);
          irsend.sendRaw(rawTmp, lastReceived.rawlen, AC_RAW_FREQ);
          digitalWrite(DEBUG_LED, LOW);
        }
        irrecv.enableIRIn();
      }
    } else if (validSignal) {
      if (lastReceived.decode_type != UNKNOWN && isProtocolSupported(lastReceived.decode_type) && lastReceived.value != 0) {
        lastCapturedCode = lastReceived.value;
        lastCapturedProto = lastReceived.decode_type;
        hasReceived = true;
        irrecv.disableIRIn();
        digitalWrite(DEBUG_LED, HIGH);
        // Fix B: Use shared helper — eliminates duplicate switch block.
        sendIRByProtoAndCode(lastCapturedProto, lastCapturedCode, nullptr, remotes[currentIndex].name);
        digitalWrite(DEBUG_LED, LOW);
        irrecv.enableIRIn();
      } else if (lastReceived.rawlen > 0 && lastReceived.rawlen <= MAX_RAW_LEN && validateRawTimings(lastReceived)) {
        lastCapturedProto = UNKNOWN; hasReceived = true;
        // Fix F: volatile-safe copy
        uint16_t rawTmp[MAX_RAW_LEN];
        for (int i = 0; i < lastReceived.rawlen; i++) rawTmp[i] = lastReceived.rawbuf[i];
        irrecv.disableIRIn();
        digitalWrite(DEBUG_LED, HIGH);
        irsend.sendRaw(rawTmp, lastReceived.rawlen,
                       strcmp(remotes[currentIndex].name, "TV") == 0 ? TV_RAW_FREQ : SPK_RAW_FREQ);
        digitalWrite(DEBUG_LED, LOW);
        irrecv.enableIRIn();
      }
    }
    digitalWrite(DEBUG_LED, LOW);
  }
}
