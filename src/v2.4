int voltageToPercentage(float voltage) {
  if (voltage >= 4.20) return 100;
  if (voltage <= 2.90) return 0;
  float voltagePoints[] = {4.20, 4.10, 4.00, 3.90, 3.80, 3.70, 3.60, 3.50, 3.20, 2.90};
  int percentagePoints[] = {100, 90, 80, 70, 50, 30, 20, 10, 5, 0};
  int numPoints = 10;
  for (int i = 0; i < numPoints - 1; i++) {
    if (voltage <= voltagePoints[i] && voltage > voltagePoints[i + 1]) {
      float voltageRange = voltagePoints[i] - voltagePoints[i + 1];
      int percentageRange = percentagePoints[i] - percentagePoints[i + 1];
      float fraction = (voltage - voltagePoints[i + 1]) / voltageRange;
      return percentagePoints[i + 1] + (int)(fraction * percentageRange + 0.5);
    }
  }
  return 0;
}

void updateBatteryPercentage() {
  long adcSum = 0;
  for (int i = 0; i < ADC_SAMPLES; i++) {
    adcSum += analogRead(BATTERY_PIN);
    ets_delay_us(100);
  }
  int adcValue = adcSum / ADC_SAMPLES;
  if (adcValue < 100 || adcValue > 4000) {
#ifdef DEBUG
    Serial.println("Error: Invalid ADC reading!");
    Serial.printf("Raw ADC: %d\n", adcValue);
#endif
    lastBatteryUpdate = millis();
    // Fix I: Force display update so the stale percentage is refreshed on-screen.
    needsDisplayUpdate = true;
    return;
  }
  float voltage = (adcValue * (ADC_VREF / 1000.0) / ADC_MAX) * VOLTAGE_DIVIDER_RATIO;
  batteryPercentage = voltageToPercentage(voltage);
#ifdef DEBUG
  Serial.printf("Battery ADC: %d, Voltage: %.2fV, Percentage: %d%%\n", adcValue, voltage, batteryPercentage);
#endif
  lastBatteryUpdate = millis();
}

// Full BLE stack init — call once at startup or after clearBonds.
// Enables bonding so the host OS reconnects automatically without a power cycle.
void initBLE(bool clearBonds = false) {
  // Fix G: Feed WDT before potentially long BLE stack init/teardown.
  if (wdtInitialized) esp_task_wdt_reset();
  if (isBLEInitialized) {
    NimBLEAdvertising* pAdv = NimBLEDevice::getAdvertising();
    if (pAdv) pAdv->stop();
    bleKeyboard.end();
    if (clearBonds) NimBLEDevice::deleteAllBonds();
    isBLEInitialized = false;
    // Brief yield — no blocking delay
    vTaskDelay(pdMS_TO_TICKS(50));
  }
  NimBLEDevice::init(BT_DEVICE_NAME);
  NimBLEDevice::setPower(ESP_PWR_LVL_P9);
  NimBLEDevice::setMTU(185);
  // Enable bonding + "just works" pairing — this is what makes auto-reconnect work.
  // Without this the host treats every connection as a brand-new device.
  NimBLEDevice::setSecurityAuth(BLE_SM_PAIR_AUTHREQ_BOND);
  NimBLEDevice::setSecurityIOCap(BLE_HS_IO_NO_INPUT_OUTPUT);
  bleKeyboard.begin();
  NimBLEAdvertising* pAdv = NimBLEDevice::getAdvertising();
  pAdv->setMinInterval(80);
  pAdv->setMaxInterval(128);
  pAdv->addServiceUUID(NimBLEUUID("1812"));
  pAdv->setName(BT_DEVICE_NAME);
  pAdv->setAppearance(0x03C0);
  pAdv->start();
  lastAdvertisingStart = millis();
  isBLEInitialized = true;
#ifdef DEBUG
  Serial.println("BLE initialized with bonding");
#endif
  showFeedback("Pair with PC");
}

// Lightweight advertising restart — does NOT tear down the BLE stack.
// Use this in the loop when disconnected; avoids the 200ms freeze.
void restartAdvertising() {
  if (!isBLEInitialized) { initBLE(false); return; }
  NimBLEAdvertising* pAdv = NimBLEDevice::getAdvertising();
  if (pAdv && !pAdv->isAdvertising()) {
    pAdv->start();
    lastAdvertisingStart = millis();
#ifdef DEBUG
    Serial.println("Advertising restarted (lightweight)");
#endif
  }
}

// Fix A: Removed dead checkWakeupButtons() — it was never called from loop().
// The encoder-button logic in loop() is the canonical handler.

void IRAM_ATTR handleEncoderButton() {
  static unsigned long lastInterruptTime = 0;
  unsigned long currentTime = millis();
  if (currentTime - lastInterruptTime > DEBOUNCE_TIME) {
    encoderBtnPressed = true;
    lastButtonTime = currentTime;
    lastInterruptTime = currentTime;
  }
}

// Individual ISRs per button so simultaneous presses are all captured correctly
static volatile unsigned long btnLastTime[5] = {0};
void IRAM_ATTR handleBtn1() {
  unsigned long t = millis();
  if (t - btnLastTime[0] >= DEBOUNCE_TIME) { btnLastTime[0] = t; lastButtonTime = t; buttonPressed[0] = true; }
}
void IRAM_ATTR handleBtn2() {
  unsigned long t = millis();
  if (t - btnLastTime[1] >= DEBOUNCE_TIME) { btnLastTime[1] = t; lastButtonTime = t; buttonPressed[1] = true; }
}
void IRAM_ATTR handleBtn3() {
  unsigned long t = millis();
  if (t - btnLastTime[2] >= DEBOUNCE_TIME) { btnLastTime[2] = t; lastButtonTime = t; buttonPressed[2] = true; }
}
void IRAM_ATTR handleBtn4() {
  unsigned long t = millis();
  if (t - btnLastTime[3] >= DEBOUNCE_TIME) { btnLastTime[3] = t; lastButtonTime = t; buttonPressed[3] = true; }
}
void IRAM_ATTR handleBtn5() {
  unsigned long t = millis();
  if (t - btnLastTime[4] >= DEBOUNCE_TIME) { btnLastTime[4] = t; lastButtonTime = t; buttonPressed[4] = true; }
}

// manageDisplayPower removed — display sleep handled by enterDeepSleep()

void setup() {
#ifdef DEBUG
  Serial.begin(115200);
  delay(100);
  Serial.println("Setup started");
#endif
  analogReadResolution(12);
  pinMode(BATTERY_PIN, INPUT);
  updateBatteryPercentage();
  pinMode(SW_PIN, INPUT_PULLUP);
  pinMode(BTN1_PIN, INPUT_PULLUP);
  pinMode(BTN2_PIN, INPUT_PULLUP);
  pinMode(BTN3_PIN, INPUT_PULLUP);
  pinMode(BTN4_PIN, INPUT_PULLUP);
  pinMode(REC_BTN_PIN, INPUT_PULLUP);
  pinMode(DEBUG_LED, OUTPUT);
  digitalWrite(DEBUG_LED, LOW);
  encoder.attachHalfQuad(CLK_PIN, DT_PIN);
  encoder.setCount(0);
  lastEncoderCount = 0;
  attachInterrupt(digitalPinToInterrupt(SW_PIN), handleEncoderButton, FALLING);
  attachInterrupt(digitalPinToInterrupt(BTN1_PIN), handleBtn1, FALLING);
  attachInterrupt(digitalPinToInterrupt(BTN2_PIN), handleBtn2, FALLING);
  attachInterrupt(digitalPinToInterrupt(BTN3_PIN), handleBtn3, FALLING);
  attachInterrupt(digitalPinToInterrupt(BTN4_PIN), handleBtn4, FALLING);
  attachInterrupt(digitalPinToInterrupt(REC_BTN_PIN), handleBtn5, FALLING);
  // Fix L: Explicitly clear the encoder-button flag after attaching the interrupt.
  // The FALLING edge from the button press that woke the device from deep sleep
  // is replayed by the hardware and would otherwise cause a phantom menu toggle
  // on the very first frame after wakeup.
  encoderBtnPressed = false;
  esp_sleep_enable_ext0_wakeup((gpio_num_t)SW_PIN, 0);
  esp_task_wdt_config_t wdt_config = {.timeout_ms = 15000, .idle_core_mask = 0, .trigger_panic = false};
  if (esp_task_wdt_init(&wdt_config) == ESP_OK) {
    wdtInitialized = true;
    esp_task_wdt_add(NULL);
  }
  WiFi.mode(WIFI_OFF);
  btStop();
  irsend.begin();
  irrecv.setUnknownThreshold(kMinUnknownSize);
  irrecv.enableIRIn();
#ifdef DEBUG
  Serial.println("IR receiver enabled in setup");
#endif
  if (!display.begin(SSD1306_SWITCHCAPVCC, OLED_ADDRESS)) {
#ifdef DEBUG
    Serial.println("SSD1306 allocation failed");
#endif
    for (;;);
  }
  Wire.setClock(100000);
  display.clearDisplay();
  display.setTextColor(SSD1306_WHITE);
  display.ssd1306_command(SSD1306_DISPLAYON);
  isDisplayOn = true;
  display.display();
  if (!prefs.begin("IRRemote", false)) {
#ifdef DEBUG
    Serial.println("Failed to initialize Preferences");
#endif
    showFeedback("Prefs Init Failed!");
    currentIndex = highlighted = 0;
  } else {
    loadProfiles();
    highlighted = currentIndex = prefs.getInt("currentIndex", currentIndex);
    if (currentIndex < 0 || currentIndex >= numRemotes) currentIndex = highlighted = 0;
  }
  initBLE(false);
  showMenu();
  lastActivity = millis();
  isDisplayOn = true;
  needsDisplayUpdate = true;
}

